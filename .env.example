# Copy this file to .env and fill in your key.
# Qwen via Alibaba Cloud Model Studio (Anthropic-compatible endpoint).
QWEN_API_BASE=https://dashscope.aliyuncs.com/apps/anthropic
QWEN_API_KEY=
QWEN_MODEL=qwen3.6-plus

# Optional comma-separated extra env names to redact from traces and reports.
SECRET_ENV_NAMES=
